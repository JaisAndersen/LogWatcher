@page
@model IndexModel
@{
    ViewData["Title"] = "LogWatcher";
}

<h1>Log Errors</h1>
@Html.AntiForgeryToken()

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Fra</label>
        <input type="datetime-local" name="From"
               value="@Model.From?.ToString("yyyy-MM-ddTHH:mm")"
               class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Til</label>
        <input type="datetime-local" name="To"
               value="@Model.To?.ToString("yyyy-MM-ddTHH:mm")"
               class="form-control" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filtrer</button>
        <a href="/" class="btn btn-secondary">Nulstil</a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @Html.ValidationMessageFor(m => m.From)
    </div>
}

<p class="text-muted small">
    Viser @Model.Errors.Items.Count af @Model.Errors.TotalCount fejl
</p>

<table class="table table-sm table-hover table-striped">
    <thead>
        <tr>
            <th>Tidspunkt</th>
            <th>Level</th>
            <th>Besked</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var error in Model.Errors.Items)
        {
            <tr>
                <td>@error.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    <span class="badge @(error.Level == "ERROR" ? "bg-danger" : "bg-warning text-dark")">
                        @error.Level
                    </span>
                </td>
                <td>@error.Message</td>
                <td>
                    @if (!error.Acknowledged)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                onclick="acknowledge('@error.Id', this)">
                            Acknowledge
                        </button>
                    }
                    else
                    {
                        <span class="text-muted small">Acknowledged</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.Errors.TotalPages > 1)
{
    var fromStr = Model.From?.ToString("yyyy-MM-ddTHH:mm");
    var toStr = Model.To?.ToString("yyyy-MM-ddTHH:mm");

    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= Model.Errors.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?CurrentPage=@p&From=@fromStr&To=@toStr">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        /// <summary>
        /// Acknowledges a log error.
        /// </summary>
        async function acknowledge(id, btn) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            await fetch('?handler=Acknowledge&id=' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });

            const cell = btn.closest('td');
            cell.innerHTML = '<span class="text-muted small">Acknowledged</span>';
        }

        /// <summary>
        /// Play a simple notification sound using the Web Audio API.
        /// </summary>
        function playNotificationSound() {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = ctx.createOscillator();
            const gain = ctx.createGain();

            oscillator.connect(gain);
            gain.connect(ctx.destination);

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, ctx.currentTime);
            oscillator.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.3);

            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);

            oscillator.start(ctx.currentTime);
            oscillator.stop(ctx.currentTime + 0.3);
        }

        /// <summary>
        /// Polls for new log errors.
        /// </summary>
        let knownIds = new Set();
        let firstPoll = true;

        async function pollForNewErrors() {
            try {
                const response = await fetch('?handler=Poll');
                const data = await response.json();

                if (firstPoll) {
                    data.items.forEach(e => knownIds.add(e.id));
                    firstPoll = false;
                    return;
                }

                const newErrors = data.items.filter(e => !knownIds.has(e.id));

                if (newErrors.length > 0) {
                    playNotificationSound();

                    const tbody = document.querySelector('tbody');

                    newErrors.forEach(error => {
                        knownIds.add(error.id);

                        const row = document.createElement('tr');
                        row.classList.add('table-warning');

                        const levelBadge = error.level === 'ERROR'
                            ? `<span class="badge bg-danger">${error.level}</span>`
                            : `<span class="badge bg-warning text-dark">${error.level}</span>`;

                        const d = new Date(error.occurredAt);
                        const occurredAt = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}`;

                        row.innerHTML = `
                            <td>${occurredAt}</td>
                            <td>${levelBadge}</td>
                            <td>${error.message}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success"
                                        onclick="acknowledge('${error.id}', this)">
                                    Acknowledge
                                </button>
                            </td>`;

                        tbody.insertBefore(row, tbody.firstChild);

                        setTimeout(() => row.classList.remove('table-warning'), 19000);
                    });

                    ///<summary>
                    /// Updates the error counter.
                    ///</summary>
                    const counter = document.querySelector('p.text-muted.small');
                    if (counter) {
                        const matches = counter.textContent.match(/\d+/g);
                        const totalCount = parseInt(matches[1]) + newErrors.length;
                        const visibleCount = document.querySelectorAll('tbody tr').length;
                        counter.textContent = `Viser ${visibleCount} af ${totalCount} fejl`;
                    }
                }
            } catch (e) {
                console.warn('Polling fejlede:', e);
            }
        }

        /// <summary>
        /// Starts polling for new log errors.
        /// </summary>
        pollForNewErrors();
        setInterval(pollForNewErrors, 20000);
    </script>
}